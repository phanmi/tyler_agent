#!/usr/bin/env bash
# Prepares the host on first boot: the data volume, Docker, and the HTTPS proxy.
# The deploy pipeline starts the backend container.
set -euo pipefail

readonly DATA_DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_device_id}"
readonly DATA_MOUNT="${data_mount_path}"
readonly DEVICE_WAIT_SECONDS=300
readonly DEVICE_POLL_SECONDS=2
readonly BLANK_CHECK_BYTES=1048576

install_packages() {
    dnf install --assumeyes docker diffutils
    systemctl enable --now docker
}

# Terraform attaches the volume after the instance has started booting.
wait_for_data_device() {
    local deadline=$((SECONDS + DEVICE_WAIT_SECONDS))
    until [[ -e "$DATA_DEVICE" ]]; do
        ((SECONDS < deadline)) || { echo "The data volume was not attached in time" >&2; exit 1; }
        sleep "$DEVICE_POLL_SECONDS"
    done
}

# Formats only a volume that reads as zeros, so a replaced host keeps the existing data.
# cmp fails on a read error, so an unreadable volume is never mistaken for a blank one.
mount_data_volume() {
    if cmp --silent --bytes="$BLANK_CHECK_BYTES" "$DATA_DEVICE" /dev/zero; then
        mkfs.ext4 "$DATA_DEVICE"
    fi
    mkdir -p "$DATA_MOUNT"
    local uuid
    uuid="$(blkid -s UUID -o value "$DATA_DEVICE")"
    echo "UUID=$uuid $DATA_MOUNT ext4 defaults,nofail 0 2" >>/etc/fstab
    mount "$DATA_MOUNT"
    install -d -o ${backend_uid} -g ${backend_uid} -m 700 "$DATA_MOUNT/backend"
    mkdir -p "$DATA_MOUNT/caddy"
}

# Caddy has no upstream timeout by default, so a chat lasting several minutes is not cut off.
# A bridge network keeps this internet-facing container away from the instance metadata service.
start_https_proxy() {
    mkdir -p /etc/caddy
    cat >/etc/caddy/Caddyfile <<CADDYFILE
${api_hostname} {
    reverse_proxy ${backend_container_name}:${backend_port}
}
CADDYFILE
    docker network create ${docker_network}
    docker run --detach --restart unless-stopped --name caddy --network ${docker_network} \
        --publish 80:80 --publish 443:443 \
        --log-driver awslogs \
        --log-opt awslogs-region=${region} \
        --log-opt awslogs-group=${log_group_name} \
        --log-opt awslogs-stream=caddy \
        --volume /etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
        --volume "$DATA_MOUNT/caddy:/data" \
        "${caddy_image}"
}

install_packages
wait_for_data_device
mount_data_volume
start_https_proxy
