{
  "protocolVersion": 1,
  "cases": [
    {
      "id": "plain_reply",
      "description": "History settles before the next chat may start.",
      "initialState": "STARTING",
      "steps": [
        {
          "ref": "ready",
          "from": "python",
          "expected": {
            "action": "accept",
            "state": "IDLE"
          }
        },
        {
          "ref": "run",
          "from": "java",
          "expected": {
            "action": "accept",
            "state": "RUNNING"
          }
        },
        {
          "ref": "completed",
          "from": "python",
          "expected": {
            "action": "accept",
            "state": "RUNNING",
            "historyAppend": 1,
            "awaitingHistory": true
          }
        },
        {
          "event": "history_settled",
          "outcome": "success",
          "expected": {
            "action": "accept",
            "state": "IDLE"
          }
        }
      ]
    },
    {
      "id": "sequential_tools",
      "description": "Each operation is dispatched once and resolved before the next; writes survive completion.",
      "initialState": "STARTING",
      "steps": [
        {
          "ref": "ready",
          "from": "python",
          "expected": {
            "action": "accept",
            "state": "IDLE"
          }
        },
        {
          "ref": "run",
          "from": "java",
          "expected": {
            "action": "accept",
            "state": "RUNNING"
          }
        },
        {
          "ref": "food_request",
          "from": "python",
          "expected": {
            "action": "accept",
            "state": "RUNNING",
            "dispatch": "food.insert",
            "writeOutcome": "unknown"
          }
        },
        {
          "ref": "food_result",
          "from": "java",
          "expected": {
            "action": "accept",
            "state": "RUNNING",
            "writeOutcome": "committed"
          }
        },
        {
          "ref": "time_request",
          "from": "python",
          "set": {
            "/payload/operationId": "op-2"
          },
          "expected": {
            "action": "accept",
            "state": "RUNNING",
            "dispatch": "time.current"
          }
        },
        {
          "ref": "time_result",
          "from": "java",
          "set": {
            "/payload/operationId": "op-2"
          },
          "expected": {
            "action": "accept",
            "state": "RUNNING"
          }
        },
        {
          "ref": "completed",
          "from": "python",
          "expected": {
            "action": "accept",
            "state": "RUNNING",
            "historyAppend": 1,
            "awaitingHistory": true
          }
        },
        {
          "event": "history_settled",
          "outcome": "success",
          "expected": {
            "action": "accept",
            "state": "IDLE"
          }
        }
      ]
    },
