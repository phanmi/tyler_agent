{
  "name": "tyler-agent-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync-version": "node scripts/sync-version.cjs",
    "predev": "node scripts/sync-version.cjs",
    "dev": "node scripts/dev.cjs",
    "predev:frontend": "node scripts/sync-version.cjs",
    "dev:frontend": "vite",
    "prebuild": "node scripts/sync-version.cjs",
    "build": "vite build",
    "test:startup": "node --test tests/electron/*.test.cjs",
    "test:version": "node --test tests/scripts/release-version.test.cjs",
    "prepreview": "node scripts/sync-version.cjs",
    "preview": "node scripts/dev.cjs --preview",
    "preelectron": "node scripts/sync-version.cjs",
    "electron": "electron electron/main.cjs",
    "prestart": "node scripts/sync-version.cjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/sync-version.cjs",
    "package": "electron-forge package",
    "premake": "node scripts/sync-version.cjs",
    "make": "electron-forge make",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node tests/electron/desktop-smoke.cjs",
    "test:runtime": "node tests/electron/java-runtime.smoke.cjs",
    "prepare:desktop": "node scripts/prepare-desktop.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-calendar": "^6.0.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "jsdom": "^27.4.0",
    "resedit": "2.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.12"
  }
}
