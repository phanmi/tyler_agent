{
  "compilerOptions": {
    // Target modern browsers with Vite's ESM output.
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // Bundler resolution supports Vite's bare imports and omitted extensions.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // Vite emits the build output; TypeScript only checks types.
    "noEmit": true,
    "jsx": "react-jsx",
    // Enable strict checks and reject unused variables.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
