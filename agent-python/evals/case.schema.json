{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One category of labelled food-recording cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "cases"],
  "properties": {
    "category": { "$ref": "#/$defs/text" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "now", "message", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "now": {
          "$comment": "The text Java's time.current returns: yyyy-MM-dd HH:mm:ss zone.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2} \\S+$"
        },
        "history": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
        "message": { "$ref": "#/$defs/text" },
        "expected": { "type": "array", "items": { "$ref": "#/$defs/expected" } }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "string" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "amount", "units", "date", "nutrition", "source"],
      "properties": {
        "names": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "amount": {
          "$comment": "null when the user gave no amount; amount and unit are then not checked.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "units": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "nutrition": {
          "$comment": "Reference values for the expected amount. Only listed nutrients are checked.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "calories": { "$ref": "#/$defs/quantity" },
            "protein": { "$ref": "#/$defs/quantity" },
            "carbs": { "$ref": "#/$defs/quantity" },
            "fat": { "$ref": "#/$defs/quantity" },
            "fiber": { "$ref": "#/$defs/quantity" }
          }
        },
        "stated": {
          "$comment": "Nutrients the user stated in the conversation; they must be saved exactly.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["calories", "protein", "carbs", "fat", "fiber"] }
        },
        "source": { "$ref": "#/$defs/text" },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative", "absolute"],
          "properties": {
            "relative": { "$ref": "#/$defs/quantity" },
            "absolute": { "$ref": "#/$defs/quantity" }
          }
        }
      },
      "if": { "properties": { "amount": { "type": "number" } } },
      "then": { "properties": { "units": { "minItems": 1 } } }
    },
    "quantity": { "type": "number", "minimum": 0 }
  }
}
