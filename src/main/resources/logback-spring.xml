<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Log directory defaults to logs/ in the working directory; override with LOG_DIR. -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <!-- Log format: time | level | thread | logger | requestId | message -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} [%X{requestId:-}] - %msg%n"/>

    <!-- Console output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rotate by date and size; retain 14 days, with a 10MB limit per file. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tyler-agent.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/tyler-agent.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Application logs default to INFO; enable DEBUG for message bodies. -->
    <logger name="org.tyler" level="INFO"/>

    <!-- Reduce OpenAI SDK and framework log noise. -->
    <logger name="com.openai" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>

</configuration>
